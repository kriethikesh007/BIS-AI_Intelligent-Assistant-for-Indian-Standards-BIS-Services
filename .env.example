# Flask Server Configuration
PORT=5000
HOST=127.0.0.1
DEBUG=True
SECRET_KEY=bis_ai_secure_token_key_2026_demo
ADMIN_API_KEY=bis_admin_secret_key_2026

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=bis_ai_db

# ML & Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RELEVANCE_THRESHOLD=0.35
SIMILARITY_TFIDF_WEIGHT=0.45
SIMILARITY_SEMANTIC_WEIGHT=0.45
CATEGORY_BOOST_WEIGHT=0.10

# Multilingual Configuration
SUPPORTED_LANGUAGES=en,hi,ta
DEFAULT_LANGUAGE=en

# Grok (xAI) API Configuration
# Get your official xAI API key from https://console.x.ai/ (docs: https://docs.x.ai/)
GROK_API_KEY=xai-your_actual_xai_grok_api_key_here
GROK_MODEL=grok-2-latest
# Default base URL is https://api.x.ai/v1 (endpoint /chat/completions)
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT=20.0
GROK_MAX_TOKENS=1000
GROK_TEMPERATURE=0.2

# Backward Compatibility (Optional fallback if using GroqCloud instead of xAI Grok)
# GROQ_API_KEY=gsk_your_groq_cloud_key_here
# GROQ_MODEL=openai/gpt-oss-120b
